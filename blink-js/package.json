{
  "name": "@specy/x86",
  "type": "module",
  "version": "2.0.5",
  "description": "X86 Emulator for JavaScript using Blink",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-assets.mjs",
    "build:wasm": "../compile_blink.sh",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rolldown-plugin-wasm": "^0.2.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
